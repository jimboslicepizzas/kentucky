      {/* Main Content Area */}
      <main className="flex-grow p-4 sm:p-8 md:py-12">
        {currentView === 'book' && renderBookingForm()}
        {currentView === 'admin' && renderAdminDashboard()}
        {currentView === 'attractions' && renderAttractions()}
